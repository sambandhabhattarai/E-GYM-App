<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="E_GYM_APP.Views.Pages.TimerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vms="clr-namespace:E_GYM_APP.ViewModels"
    Title="TimerPage"
    x:DataType="vms:TimerViewModel">

    <VerticalStackLayout
        Padding="30"
        BackgroundColor="White"
        Spacing="20">
        <Label
            FontAttributes="Bold"
            FontSize="24"
            HorizontalOptions="Center"
            Text="{Binding ExerciseName}"
            TextColor="Black" />
        <Frame
            BackgroundColor="#F7F7FC"
            CornerRadius="200"
            HeightRequest="300"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="300">
            <Image
                Aspect="AspectFill"
                BackgroundColor="{StaticResource White}"
                HorizontalOptions="Center"
                IsAnimationPlaying="{Binding IsAnimationPlaying}"
                Source="{Binding ExerciseImageSource}"
                VerticalOptions="Center" />
        </Frame>
        <Label
            FontSize="48"
            HorizontalOptions="Center"
            Text="{Binding TimerDisplay}"
            TextColor="Black" />
        <Button
            Padding="10,5"
            BackgroundColor="#92A3FD"
            Command="{Binding StartCommand}"
            CornerRadius="10"
            FontSize="16"
            HorizontalOptions="Center"
            Text="Start"
            TextColor="{StaticResource White}"
            VerticalOptions="Center"
            WidthRequest="250" />
        <Button
            Padding="10,5"
            BackgroundColor="#92A3FD"
            Command="{Binding PauseCommand}"
            CornerRadius="10"
            FontSize="16"
            HorizontalOptions="Center"
            Text="Pause"
            TextColor="White"
            VerticalOptions="Center"
            WidthRequest="250" />
        <Button
            Padding="10,5"
            BackgroundColor="#92A3FD"
            Command="{Binding ResetCommand}"
            CornerRadius="10"
            FontSize="16"
            HorizontalOptions="Center"
            Text="Reset"
            TextColor="{StaticResource White}"
            VerticalOptions="Center"
            WidthRequest="250" />
    </VerticalStackLayout>
</ContentPage>
