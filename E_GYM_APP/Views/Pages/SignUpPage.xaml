<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="E_GYM_APP.Views.Pages.SignUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:E_GYM_APP.Converters"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:E_GYM_APP.ViewModels"
    Title="SignUpPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BooleanAndConverter x:Key="BooleanAndConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.BindingContext>
        <vm:RegisterViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label
                Padding="50,10,50,0"
                FontSize="Large"
                HorizontalOptions="Center"
                Text="Hey there,"
                VerticalOptions="Start" />
            <Label
                FontAttributes="Bold"
                FontSize="Title"
                HorizontalOptions="Center"
                Text="Create an Account" />
            <Frame
                Padding="0"
                BorderColor="Gray"
                CornerRadius="15"
                HasShadow="False"
                HeightRequest="50">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="10,0"
                        HeightRequest="24"
                        HorizontalOptions="Start"
                        Source="name.png"
                        VerticalOptions="Center"
                        WidthRequest="24" />
                    <Entry
                        Grid.Column="1"
                        Placeholder="Username"
                        Text="{Binding Username}"
                        TextColor="{StaticResource Black}"
                        VerticalOptions="Center">
                        <Entry.Behaviors>
                            <toolkit:MultiValidationBehavior x:Name="UsernameValidation" Flags="ValidateOnUnfocusing,ValidateOnValueChanged">
                                <toolkit:CharactersValidationBehavior toolkit:MultiValidationBehavior.Error="Please enter an alphanumeric username of 2-15 characters." RegexPattern="^[a-zA-Z0-9]{2,15}$" />
                            </toolkit:MultiValidationBehavior>
                        </Entry.Behaviors>
                    </Entry>
                </Grid>
            </Frame>
            <Label
                FontSize="12"
                IsVisible="{Binding Source={x:Reference UsernameValidation}, Path=IsValid, Converter={toolkit:InvertedBoolConverter}}"
                Text="{Binding Source={x:Reference UsernameValidation}, Path=Errors[0]}" />
            <Frame
                Padding="0"
                BorderColor="Gray"
                CornerRadius="15"
                HasShadow="False"
                HeightRequest="50">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="10,0"
                        HeightRequest="24"
                        HorizontalOptions="Start"
                        Source="email.png"
                        VerticalOptions="Center"
                        WidthRequest="24" />
                    <Entry
                        Grid.Column="1"
                        Keyboard="Email"
                        Placeholder="Email"
                        Text="{Binding Email}"
                        TextColor="{StaticResource Black}"
                        VerticalOptions="Center">
                        <Entry.Behaviors>
                            <toolkit:EmailValidationBehavior x:Name="EmailValidation" Flags="ValidateOnValueChanged,ValidateOnUnfocusing" />
                        </Entry.Behaviors>
                    </Entry>
                </Grid>
            </Frame>
            <Label
                FontSize="12"
                IsVisible="{Binding Source={x:Reference EmailValidation}, Path=IsValid, Converter={toolkit:InvertedBoolConverter}}"
                Text="{Binding Source={x:Reference EmailValidation}, StringFormat='Please enter a valid email address.'}" />
            <Frame
                Padding="0"
                BorderColor="Gray"
                CornerRadius="15"
                HasShadow="False"
                HeightRequest="50">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="10,0"
                        HeightRequest="24"
                        HorizontalOptions="Start"
                        Source="password.png"
                        VerticalOptions="Center"
                        WidthRequest="24" />
                    <Entry
                        Grid.Column="1"
                        IsPassword="True"
                        Placeholder="Password"
                        Text="{Binding Password}"
                        TextColor="{StaticResource Black}"
                        VerticalOptions="Center">
                        <Entry.Behaviors>
                            <toolkit:MultiValidationBehavior x:Name="PasswordValidation" Flags="ValidateOnValueChanged,ValidateOnUnfocusing">
                                <toolkit:CharactersValidationBehavior
                                    x:Name="DigitValidation"
                                    toolkit:MultiValidationBehavior.Error="Password must contain at least 1 digit"
                                    CharacterType="Digit"
                                    MinimumCharacterTypeCount="1" />
                                <toolkit:CharactersValidationBehavior
                                    x:Name="UpperValidation"
                                    toolkit:MultiValidationBehavior.Error="Password must contain at least 1 uppercase letter"
                                    CharacterType="UppercaseLetter"
                                    MinimumCharacterTypeCount="1" />
                                <toolkit:CharactersValidationBehavior
                                    x:Name="SymbolValidation"
                                    toolkit:MultiValidationBehavior.Error="Password must contain at least 1 symbol"
                                    CharacterType="NonAlphanumericSymbol"
                                    MinimumCharacterTypeCount="1" />
                                <toolkit:CharactersValidationBehavior
                                    x:Name="AnyValidation"
                                    toolkit:MultiValidationBehavior.Error="Password must be at least 8 characters long"
                                    CharacterType="Any"
                                    MinimumCharacterTypeCount="8" />
                            </toolkit:MultiValidationBehavior>
                        </Entry.Behaviors>
                    </Entry>
                </Grid>
            </Frame>
            <Label
                FontSize="12"
                IsVisible="{Binding Source={x:Reference PasswordValidation}, Path=IsValid, Converter={toolkit:InvertedBoolConverter}}"
                Text="{Binding Source={x:Reference PasswordValidation}, Path=Errors[0]}" />
            <HorizontalStackLayout
                Margin="0,2,0,0"
                Spacing="10"
                VerticalOptions="Center">
                <CheckBox x:Name="TermsCheckBox" />
                <Label Text="I agree to the terms and conditions" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button
                Margin="20,100,20,0"
                BackgroundColor="#86a8e7"
                Command="{Binding SignUpCommand}"
                CornerRadius="25"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="Register"
                TextColor="White">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                        <Binding Path="IsValid" Source="{x:Reference UsernameValidation}" />
                        <Binding Path="IsChecked" Source="{x:Reference TermsCheckBox}" />
                        <Binding Path="IsValid" Source="{x:Reference EmailValidation}" />
                        <Binding Path="IsValid" Source="{x:Reference PasswordValidation}" />
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
            <ActivityIndicator
                x:Name="LoadingIndicator"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="End"
                Color="Blue" />
            <BoxView
                Margin="0,20"
                HeightRequest="1"
                HorizontalOptions="FillAndExpand"
                Color="Gray" />
            <Label
                Margin="0,10,10,0"
                HorizontalOptions="Center"
                Text="Already have an account?"
                VerticalOptions="Center" />
            <Button
                BackgroundColor="White"
                Command="{Binding LoginCommand}"
                FontAttributes="Bold"
                FontSize="Header"
                HeightRequest="40"
                Text="Login"
                TextColor="#EEA4CE"
                WidthRequest="81" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
